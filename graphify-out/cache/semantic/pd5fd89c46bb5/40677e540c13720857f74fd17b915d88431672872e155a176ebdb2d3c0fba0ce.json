{"nodes": [{"id": "frontend_claude_agente_de_inventario", "label": "Agente de Inventario \u2014 spec (CLAUDE.md)", "file_type": "document", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_claude_stack_tecnologico", "label": "Stack tecnol\u00f3gico (no negociable)", "file_type": "rationale", "rationale": "React+Vite+TS/Tailwind/Zustand/vite-plugin-pwa/html5-qrcode/Web Speech API/xlsx/Gemini/lucide-react fijados como stack cerrado para que la fase de UI avance sin fricci\u00f3n de decisiones ni dependencias nuevas.", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_claude_arquitectura_capas", "label": "Arquitectura de capas (services layer, regla de oro)", "file_type": "rationale", "rationale": "Las pantallas nunca llaman APIs directamente; todo pasa por src/services/ para que el backend real (Supabase/Gemini) pueda enchufarse despu\u00e9s sin tocar la UI.", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_claude_gemini_service", "label": "services/ai/gemini.ts \u2014 interpretCount()", "file_type": "code", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_claude_localparser_service", "label": "services/ai/localParser.ts (parser regex sin IA)", "file_type": "code", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_claude_conteo_ciego", "label": "Conteo ciego (el operario nunca ve el SD te\u00f3rico)", "file_type": "rationale", "rationale": "Evita sesgar el conteo f\u00edsico por el valor del sistema; el te\u00f3rico solo se muestra en